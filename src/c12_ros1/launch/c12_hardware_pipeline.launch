<launch>

  <!-- =========================
       原有 C12 任务参数
       ========================= -->

  <arg name="enable_rviz" default="true"/>
  <arg name="enable_stability_check" default="false"/>
  <arg name="auto_start" default="true"/>
  <arg name="enable_search" default="true"/>
  <arg name="enable_tracking" default="true"/>

  <arg name="camera_ip" default="192.168.1.91"/>

  <arg name="target_id" default="0"/>
  <arg name="tag_size_m" default="0.10"/>

  <arg name="hover_height_m" default="1.2"/>

  <arg name="lio_odom_topic" default="/lio/robo/odom"/>
  <arg name="planner_goal_topic" default="/remote/goal"/>

  <arg name="world_frame" default="world"/>
  <arg name="base_frame" default="base_link"/>

  <arg name="mount_to_yaw_xyz" default="0 0 0"/>
  <arg name="mount_to_yaw_rpy" default="0 0 0"/>

  <arg name="yaw_to_pitch_xyz" default="0 0 0"/>
  <arg name="yaw_to_pitch_rpy" default="0 0 0"/>

  <arg name="pitch_to_roll_xyz" default="0 0 0"/>
  <arg name="pitch_to_roll_rpy" default="0 0 0"/>

  <arg name="roll_to_camera_xyz" default="0 0 0"/>
  <arg name="roll_to_camera_rpy" default="-1.5708 0 -1.5708"/>


  <!-- ==========================================================
       夹爪参数
       
       enable_gripper=false:
       关闭“到达目标后自动投掷”
       但是夹爪节点仍然启动，可以手动调用
       /gripper/open
       /gripper/close
       
       台架测试通过后启动时设置：
       enable_gripper:=true
       ========================================================== -->

  <arg name="enable_gripper" default="false"/>

  <!--
      Pixhawk 6C 输出通道
      当前默认 FMU_CH7
      如果接的是 CH8，改成 8
  -->
  <arg name="gripper_fmu_channel" default="7"/>

  <!-- 夹爪张开 PWM -->
  <arg name="gripper_open_pwm" default="1200"/>

  <!-- 夹爪闭合 PWM -->
  <arg name="gripper_close_pwm" default="1800"/>


  <!-- =========================
       加载所有 YAML 参数
       ========================= -->

  <rosparam
      file="$(find c12_ros1)/config/c12_pipeline.yaml"
      command="load"/>


  <!-- =========================
       Robot Description
       ========================= -->

  <param
      name="robot_description"
      command="$(find xacro)/xacro '$(find c12_ros1)/urdf/c12_gimbal.urdf.xacro'
               mount_to_yaw_xyz:='$(arg mount_to_yaw_xyz)'
               mount_to_yaw_rpy:='$(arg mount_to_yaw_rpy)'
               yaw_to_pitch_xyz:='$(arg yaw_to_pitch_xyz)'
               yaw_to_pitch_rpy:='$(arg yaw_to_pitch_rpy)'
               pitch_to_roll_xyz:='$(arg pitch_to_roll_xyz)'
               pitch_to_roll_rpy:='$(arg pitch_to_roll_rpy)'
               roll_to_camera_xyz:='$(arg roll_to_camera_xyz)'
               roll_to_camera_rpy:='$(arg roll_to_camera_rpy)'"/>


  <!-- =========================
       Robot State Publisher
       ========================= -->

  <node
      pkg="robot_state_publisher"
      type="robot_state_publisher"
      name="c12_robot_state_publisher"
      output="screen">

    <remap
        from="/joint_states"
        to="/c12/gimbal/joint_states"/>

  </node>


  <!-- =========================
       base_link -> c12_mount
       ========================= -->

  <node
      pkg="c12_ros1"
      type="static_tf_from_params_node.py"
      name="c12_static_base_to_mount"
      output="screen">

    <param
        name="parent_frame"
        value="$(arg base_frame)"/>

    <param
        name="child_frame"
        value="c12_mount"/>

  </node>


  <!-- =========================
       LIO Odom -> TF
       ========================= -->

  <node
      pkg="c12_ros1"
      type="odom_tf_bridge_node.py"
      name="c12_odom_tf_bridge"
      output="screen">

    <param
        name="odom_topic"
        value="$(arg lio_odom_topic)"/>

    <param
        name="world_frame_override"
        value="$(arg world_frame)"/>

    <param
        name="base_frame_override"
        value="$(arg base_frame)"/>

  </node>


  <!-- =========================
       C12 云台
       ========================= -->

  <node
      pkg="c12_ros1"
      type="c12_gimbal_node.py"
      name="c12_gimbal"
      output="screen">

    <param
        name="camera_ip"
        value="$(arg camera_ip)"/>

  </node>


  <!-- =========================
       AprilTag 检测
       ========================= -->

  <node
      pkg="c12_ros1"
      type="c12_tag_pose_node.py"
      name="c12_tag_pose"
      output="screen">

    <param
        name="rtsp_url"
        value="rtsp://$(arg camera_ip):554/stream=1"/>

    <param
        name="camera_info_file"
        value="$(find c12_ros1)/config/camera_1280x720.yaml"/>

    <param
        name="target_id"
        value="$(arg target_id)"/>

    <param
        name="tag_size_m"
        value="$(arg tag_size_m)"/>

    <param
        name="enable_gimbal_search"
        value="$(arg enable_search)"/>

    <param
        name="enable_gimbal_tracking"
        value="$(arg enable_tracking)"/>

  </node>


  <!-- =========================
       AprilTag 世界坐标定位
       ========================= -->

  <node
      pkg="c12_ros1"
      type="c12_tag_localization_node.py"
      name="c12_tag_localization"
      output="screen">

    <param
        name="world_frame"
        value="$(arg world_frame)"/>

  </node>


  <!-- =========================
       Tag Mission
       
       负责：
       搜索目标
       ↓
       锁定目标
       ↓
       发布 /remote/goal
       ↓
       判断无人机是否 ARRIVED
       ========================= -->

  <node
      pkg="c12_ros1"
      type="c12_tag_mission_node.py"
      name="c12_tag_mission"
      output="screen">

    <param
        name="auto_start"
        value="$(arg auto_start)"/>

    <param
        name="world_frame"
        value="$(arg world_frame)"/>

    <param
        name="odom_topic"
        value="$(arg lio_odom_topic)"/>

    <param
        name="planner_goal_topic"
        value="$(arg planner_goal_topic)"/>

    <param
        name="hover_height_m"
        value="$(arg hover_height_m)"/>

  </node>


  <!-- ==========================================================
       夹爪自动投掷节点
       
       自动流程：
       
       /tag_mission/arrived = true
                   ↓
       /tag_mission/state = ARRIVED
                   ↓
       检查 /lio/robo/odom
                   ↓
       判断无人机是否稳定
                   ↓
       检查 MAVROS / PX4
                   ↓
       MAV_CMD_DO_SET_ACTUATOR
                   ↓
       FMU_CH7 / FMU_CH8
                   ↓
       夹爪张开
       ========================================================== -->

  <node
      pkg="c12_ros1"
      type="c12_gripper_release_node.py"
      name="c12_gripper_release"
      output="screen">

    <!--
        是否允许自动投掷
        false 时仍然可以手动开关夹爪
    -->
    <param
        name="enabled"
        value="$(arg enable_gripper)"/>

    <!--
        与 C12 Mission 使用同一个 LIO 里程计
    -->
    <param
        name="odom_topic"
        value="$(arg lio_odom_topic)"/>

    <!--
        Pixhawk FMU 输出通道
    -->
    <param
        name="fmu_channel"
        value="$(arg gripper_fmu_channel)"/>

    <!-- 张开 PWM -->
    <param
        name="open_pwm"
        value="$(arg gripper_open_pwm)"/>

    <!-- 闭合 PWM -->
    <param
        name="close_pwm"
        value="$(arg gripper_close_pwm)"/>

  </node>


  <!-- =========================
       Tag 稳定性检测
       ========================= -->

  <node
      if="$(arg enable_stability_check)"
      pkg="c12_ros1"
      type="tag_world_stability_check_node.py"
      name="c12_tag_world_stability_check"
      output="screen"/>


  <!--
  <node
      if="$(arg enable_rviz)"
      pkg="rviz"
      type="rviz"
      name="c12_task_rviz"
      args="-d $(find c12_ros1)/config/c12_task.rviz"
      output="screen"/>
  -->

</launch>